server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback - react-router owns the routing client side.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Mirrors the "/finance" proxy from vite.config.ts.
  location /finance/ {
    proxy_pass ${API_URL}/finance/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
