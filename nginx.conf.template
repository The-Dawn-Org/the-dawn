server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback - react-router owns the routing client side.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Every API prefix the client calls, forwarded to the server. Mirrors the
  # proxy in vite.config.ts so dev and the built image resolve the same URLs,
  # which keeps the requests same-origin and sidesteps CORS entirely.
  location ~ ^/(finance|events|ai-analysis|report)(/|$) {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
